---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Ph from '../../../components/Ph.astro';
import { tagSlug } from '../../../site';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, author, summary, image, tags } = post.data;
---
<Base title={title} description={summary}>
  <article>
    <section class="page-head">
      <div class="container narrow">
        <p class="eyebrow"><a href="/news/">News</a></p>
        <h1><Ph v={title} /></h1>
        <p class="meta"><time datetime={date.toISOString()}>{date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time> · {author}</p>
        <ul class="tags">{tags.map((t) => <li><a class="tag" href={`/news/tag/${tagSlug(t)}/`}>{t}</a></li>)}</ul>
      </div>
    </section>
    <section class="section" style="padding-top:8px">
      <div class="container narrow prose">
        {image && <img src={image} alt="" style="border-radius:var(--radius);margin-bottom:24px" />}
        <Content />
        <p style="margin-top:40px"><a href="/news/">← All news</a></p>
      </div>
    </section>
  </article>
</Base>
